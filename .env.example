NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Sem as duas variáveis Supabase, a demonstração funciona apenas fora de produção.
DEMO_MODE=false
# Obrigatórios em produção: serviço Redis REST compatível com EVAL.
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=
# Ative somente atrás de um proxy que sobrescreva X-Forwarded-For/Proto.
TRUST_PROXY=false
# SUPABASE_SERVICE_ROLE_KEY e ADMIN_PASSWORD pertencem apenas ao terminal
# dos scripts administrativos; não configure no processo web.

# Ative em staging para medir o cache autenticado da fila.
TICKET_CACHE_ENABLED=false
